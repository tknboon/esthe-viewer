#!/bin/sh

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./sync-public-assets.ps1"
status=$?

if [ $status -ne 0 ]; then
  echo "Public asset sync failed."
  exit $status
fi

git add docs/index.html docs/app.js docs/styles.css docs/data.js docs/firebase-config.js docs/favicon.svg docs/CNAME
git add site/index.html site/app.js site/styles.css site/data.js site/firebase-config.js site/favicon.svg site/CNAME
