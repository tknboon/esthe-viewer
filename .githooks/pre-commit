#!/bin/sh

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./sync-public-assets.ps1"
status=$?

if [ $status -ne 0 ]; then
  echo "Public asset sync failed."
  exit $status
fi

git add docs/index.html docs/store.html docs/app.js docs/store-page.js docs/styles.css docs/data.js docs/firebase-config.js docs/favicon.svg docs/sitemap.xml docs/robots.txt docs/CNAME
git add docs/stores
